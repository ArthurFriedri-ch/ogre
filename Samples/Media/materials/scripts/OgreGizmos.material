material MAT_GIZMO_VERTEX
{
	technique
	{
		pass
		{
            lighting off
            vertex_colour_tracking ambient_diffuse
            polygon_mode solid
            polygon_mode_overrideable false
            cull_hardware none
            cull_software none
            depth_check off
		}
	}
}

material MAT_GIZMO_VERTEX_ALPHA : MAT_GIZMO_VERTEX
{
    technique
    {
        pass
        {
            scene_blend alpha_blend
        }
    }
}


material MAT_GIZMO_VERTEX_L
{
	technique
	{
		pass
		{
			ambient 0 0 0 0.9
			diffuse 0.2 0.2 0.2 0.9
                  specular 0 0 0 0.9
                  emissive 1 0 0 0.9
                  polygon_mode solid
                  polygon_mode_overrideable false
                  depth_check off
                  cull_hardware none
                  cull_software none
                  depth_check off
		}
	}
}